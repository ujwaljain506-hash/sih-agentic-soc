# ─── AI Engine (REQUIRED for agent.py and POST /analyze/{id}) ───────────────
# Get a free key at https://console.groq.com → API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ─── Alerting (OPTIONAL) ────────────────────────────────────────────────────
# Discord channel webhook (Server Settings → Integrations → Webhooks).
# Slack also accepts posts but renders best with Discord format.
# Leave empty to disable alerts.
WEBHOOK_URL=

# ─── API Authentication (OPTIONAL) ──────────────────────────────────────────
# If set, every /logs, /stats and /analyze request must include the header:
#   X-API-Key: <value>
# Leave empty to run the API open (fine for demos).
API_KEY=
